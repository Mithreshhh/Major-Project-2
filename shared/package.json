{
  "name": "@odpa/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Data contract between the extension (client) and the FastAPI server: TypeScript types + JSON Schemas.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*",
    "./examples/*": "./examples/*"
  },
  "files": ["src", "schema", "examples"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
