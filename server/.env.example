# Copy the variables you need into your shell; the app reads plain environment variables
# (no .env loader) so nothing here is picked up automatically.

# Which reasoner answers /process: "gemma" (Ollama, default) or "mock" (no model, used by tests)
REASONER=gemma

# Ollama HTTP API and model tag (as printed by `ollama list`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ledgerguard-gemma4-e2b-q4-0:latest

# Generation settings
OLLAMA_TIMEOUT_S=120
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=10m

# Screenshot handling: auto (only if the model advertises vision), always, never
GEMMA_SEND_SCREENSHOT=auto
# Max UI elements described per prompt (interactive ones are kept first)
GEMMA_MAX_ELEMENTS=60

# Set to 1 to run tests/integration against the live model
# RUN_GEMMA_INTEGRATION=1
